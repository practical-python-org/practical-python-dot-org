# A .editorconfig file standardizes code style and formatting
# settings across different editors and IDEs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,cfg,ini}]
indent_style = space
indent_size = 2

[*.{css,html}]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for a hard line break. Stripping them
# silently reflows paragraphs, so leave whitespace alone here.
[*.md]
trim_trailing_whitespace = false
